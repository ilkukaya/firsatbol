# =============================================================================
# FırsatBol — environment variables
# Copy to `.env` for local development (never commit `.env`).
# On Netlify: Site configuration → Environment variables. Mark secrets as "secret".
# Variables WITHOUT the PUBLIC_ prefix are server/build-only. Never prefix a secret with PUBLIC_.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Canonical origin. Leave empty on Netlify until the custom domain is live:
# Netlify's URL variable (primary domain) is used automatically.
SITE_URL=

# --- Fırsat Bu Fırsat publisher API (SECRET — build + functions scope) ----------
# Rotate any key that was ever shared in chat, email or screenshots before using it.
FIRSATBUFIRSAT_API_KEY=
FIRSATBUFIRSAT_PUBLISHER_ID=
# Verified endpoint (default shown). Response: JSON, 10 deals/page, max 20 pages per query.
FIRSATBUFIRSAT_API_BASE_URL=https://api.firsatbufirsat.com/deal/browse.html
# Extra parameters applied to EVERY request (optional, e.g. a channel filter from the dashboard).
FIRSATBUFIRSAT_EXTRA_QUERY=
# Province sweep: "all" (cityId 1–81, default), "none" (single unfiltered query, max 200 deals)
# or a comma list of the partner's cityIds (e.g. 7,41,42 = Ankara, İstanbul, İzmir).
FIRSATBUFIRSAT_CITY_IDS=all
# Additional swept queries separated by | — use for districts of big cities, which exceed the
# 200-deals-per-query limit, e.g.  cityId=41&townId=<id>|cityId=41&townId=<id>
FIRSATBUFIRSAT_QUERIES=
# Parallel requests during the sweep (1–6) and minimum gap between request starts.
FIRSATBUFIRSAT_CONCURRENCY=3
# Optional additional requests whose results get the provider's "popular"/"new" label:
FIRSATBUFIRSAT_POPULAR_QUERY=
FIRSATBUFIRSAT_NEW_QUERY=
# Pagination (verified defaults: page parameter "p", max 20 pages):
FIRSATBUFIRSAT_PAGE_PARAM=p
FIRSATBUFIRSAT_MAX_PAGES=20
# Override single verified field paths only if the partner changes its response:
# FIRSATBUFIRSAT_FIELD_MAP={"imageUrl":"image1200x1200"}
FIRSATBUFIRSAT_FIELD_MAP=
# Links already carry pid=<publisherId>. Set true after Günlük Raporlar shows the clicks.
FIRSATBUFIRSAT_TRACKING_VERIFIED=false
# Optional "Link Oluşturma" template: placeholders {url} {urlEncoded} {publisherId} {id}
FIRSATBUFIRSAT_LINK_TEMPLATE=
# Optional Etkinlik API endpoint (exact URL from the dashboard) + its extra query:
FIRSATBUFIRSAT_EVENTS_API_URL=
FIRSATBUFIRSAT_EVENTS_EXTRA_QUERY=
FIRSATBUFIRSAT_TIMEOUT_MS=20000
FIRSATBUFIRSAT_RETRIES=3
FIRSATBUFIRSAT_MIN_INTERVAL_MS=350

# --- Additional authorised feeds (SECRET if URLs contain tokens) ----------------
# JSON array, see docs/PROVIDERS.md. Leave empty until a programme approves the site.
DEAL_FEEDS=

# --- Deal pipeline ---------------------------------------------------------------
# Allow indexing provider deal pages with substantial descriptions (default: only pages with
# an original FırsatBol summary are indexable).
DEALS_INDEX_PROVIDER_PAGES=false
# Fail the build when a configured provider errors, so Netlify keeps the last good deploy live.
# Defaults to true in production context, false elsewhere.
DEALS_FAIL_BUILD_ON_PROVIDER_ERROR=
# Hours between scheduled change checks (one cheap API request; the sync function runs hourly).
DEALS_REFRESH_INTERVAL_HOURS=6
# Rebuild at least this often even without detected changes (prices/expiry stay fresh).
DEALS_MAX_DATA_AGE_HOURS=24
# Local development only: use synthetic fixtures (ignored in production context).
DEALS_USE_FIXTURES=false

# --- Operations (SECRET — functions scope) ----------------------------------------
# Build hook URL (Site configuration → Build & deploy → Build hooks) used by the scheduler
# and the manual refresh endpoint.
NETLIFY_BUILD_HOOK_URL=
# Long random string (≥ 24 chars) for /api/admin/stats and /api/admin/refresh.
ADMIN_TOKEN=

# --- Newsletter (Brevo, double opt-in) ----------------------------------------------
PUBLIC_NEWSLETTER_ENABLED=false
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
# Defaults to <SITE_URL>/bulten/onay/
BREVO_REDIRECT_URL=

# --- Publisher / data controller details (public, shown on legal pages) -------------
SITE_CONTROLLER_NAME=
SITE_CONTROLLER_ADDRESS=
SITE_CONTACT_EMAIL=
SITE_KEP_ADDRESS=
SITE_MERSIS_NO=

# --- Analytics & verification (public) ------------------------------------------------
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=
# GA4 is loaded only after cookie consent:
PUBLIC_GA4_ID=
PUBLIC_FIRST_PARTY_EVENTS=true
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_YANDEX_VERIFICATION=

# --- Social profiles (public, https only) ----------------------------------------------
PUBLIC_SOCIAL_INSTAGRAM=
PUBLIC_SOCIAL_X=
PUBLIC_SOCIAL_FACEBOOK=
PUBLIC_SOCIAL_YOUTUBE=

# --- Advertising (keep false until an ad network approves the site) --------------------
PUBLIC_ADS_ENABLED=false
