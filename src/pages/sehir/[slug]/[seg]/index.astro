---
import type { GetStaticPaths } from 'astro';
import CitySegmentView from '../../../../components/CitySegmentView.astro';
import { getDeals } from '../../../../lib/deals/repository';
import { facetsOf, type CityFacetPage } from '../../../../lib/deals/facets';

/** /sehir/<city>/<district>/ and /sehir/<city>/<tag>/ (a district wins a slug clash). */
export const getStaticPaths = (async () => {
  const { deals } = await getDeals();
  return facetsOf(deals).citySegments.map((page) => ({ params: { slug: page.citySlug, seg: page.slug }, props: { page } }));
}) satisfies GetStaticPaths;

interface Props {
  page: CityFacetPage;
}
const { page } = Astro.props;
---

<CitySegmentView page={page} pageNo={1} />
