---
import type { GetStaticPaths } from 'astro';
import DistrictTagView from '../../../../components/DistrictTagView.astro';
import { getDeals } from '../../../../lib/deals/repository';
import { facetsOf, type DistrictTagPage } from '../../../../lib/deals/facets';

/** /sehir/<city>/<district>/<tag>/, e.g. /sehir/istanbul/kadikoy/masaj/ */
export const getStaticPaths = (async () => {
  const { deals } = await getDeals();
  return facetsOf(deals).districtTags.map((page) => ({
    params: { slug: page.citySlug, seg: page.districtSlug, tag: page.slug },
    props: { page },
  }));
}) satisfies GetStaticPaths;

interface Props {
  page: DistrictTagPage;
}
const { page } = Astro.props;
---

<DistrictTagView page={page} pageNo={1} />
