---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AttributionNotice from '../../components/AttributionNotice.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DealGrid from '../../components/DealGrid.astro';
import EmptyDeals from '../../components/EmptyDeals.astro';
import Icon from '../../components/Icon.astro';
import FilterBar from '../../components/FilterBar.astro';
import { CATEGORIES } from '../../config/categories';
import { getDeals } from '../../lib/deals/repository';
import { MIN_CITY_INDEX, MIN_COMBO_PAGE, citiesWithDeals, countBy, type CityEntry } from '../../lib/deals/taxonomy';
import { sortEntries, toIndexEntry } from '../../lib/deals/query';
import { breadcrumbJsonLd } from '../../lib/seo';
import { facetsOf, rootLinks, topTagLinks, topicLinkGroups } from '../../lib/deals/facets';

export const getStaticPaths = (async () => {
  const { deals } = await getDeals();
  return citiesWithDeals(deals).map((city) => ({ params: { slug: city.slug }, props: { city } }));
}) satisfies GetStaticPaths;

interface Props {
  city: CityEntry;
}
const { city } = Astro.props;
const { deals } = await getDeals();
const byId = new Map(deals.map((deal) => [deal.id, deal]));
const cityDeals = sortEntries(deals.filter((deal) => deal.citySlug === city.slug).map(toIndexEntry)).map((entry) => byId.get(entry.id)!);
const shown = cityDeals.slice(0, 48);
const perCategory = countBy(cityDeals, (deal) => deal.category);
const { citySegments } = facetsOf(deals);
const districtLinks = citySegments
  .filter((page) => page.citySlug === city.slug && page.kind === 'district')
  .sort((a, b) => b.deals.length - a.deals.length);
// category tree of the city (Masaj › Spa › Hamam…), then the remaining provider tags
const subPages = new Set(citySegments.filter((page) => page.citySlug === city.slug && page.kind === 'tag').map((page) => page.slug));
const cityHref = (slug: string) => `/sehir/${city.slug}/${slug}/`;
const tree = topicLinkGroups(cityDeals, subPages, cityHref, { maxDepth: 1 });
const quick = rootLinks(tree);
const menus = [
  {
    label: 'İlçeler',
    icon: 'pin' as const,
    groups: [
      {
        title: `${city.name} ilçeleri`,
        items: [...districtLinks]
          .sort((a, b) => a.name.localeCompare(b.name, 'tr'))
          .map((page) => ({ href: `/sehir/${city.slug}/${page.slug}/`, label: page.name, count: page.deals.length })),
      },
    ],
  },
  {
    label: 'Kategoriler',
    icon: 'tag' as const,
    groups: [
      {
        title: 'Ana kategoriler',
        items: CATEGORIES.filter((category) => perCategory.has(category.slug)).map((category) => {
          const count = perCategory.get(category.slug)!;
          return {
            href:
              count >= MIN_COMBO_PAGE
                ? `/kategori/${category.slug}/${city.slug}/`
                : `/firsatlar/?kategori=${category.slug}&sehir=${city.slug}`,
            label: category.shortName,
            count,
          };
        }),
      },
      ...tree,
      {
        title: 'Diğer alt kategoriler',
        items: topTagLinks(cityDeals, subPages, 24).map((tag) => ({ href: cityHref(tag.slug), label: tag.name, count: tag.count })),
      },
    ],
  },
];
const crumbs = [
  { name: 'Ana sayfa', path: '/' },
  { name: 'Şehirler', path: '/firsatlar/' },
  { name: city.name, path: `/sehir/${city.slug}/` },
];
const intro =
  city.intro ??
  `${city.name} için iş ortaklarımızdan gelen güncel fırsatları burada listeliyoruz. Fırsatların geçerli olduğu ilçe ve şubeyi satın almadan önce kontrol etmeyi unutmayın.`;
---

<BaseLayout
  title={`${city.name} Fırsatları ve Kampanyaları`}
  description={`${city.name} için yeme içme, güzellik, etkinlik ve konaklama fırsatları. ${city.count > 0 ? `${city.count} güncel fırsatı` : 'Güncel fırsatları'} kategori ve ilçe bilgisiyle inceleyin.`}
  canonical={`/sehir/${city.slug}/`}
  noindex={city.count < MIN_CITY_INDEX}
  jsonLd={[breadcrumbJsonLd(crumbs)]}
>
  <section class="border-b border-line bg-white">
    <div class="container-page py-6 sm:py-8">
      <Breadcrumbs crumbs={crumbs} />
      <div class="mt-5 max-w-3xl">
        <p class="flex items-center gap-2 text-sm font-semibold text-muted">
          <Icon name="pin" size={17} class="text-brand-text" />
          {city.count > 0 ? `${city.count} güncel fırsat` : 'Güncel fırsat bekleniyor'}
        </p>
        <h1 class="mt-3 font-display text-3xl font-extrabold tracking-tight sm:text-[2.6rem] sm:leading-[1.1]">{city.name} fırsatları</h1>
        <p class="mt-4 line-clamp-3 text-[1.05rem] leading-relaxed text-ink-2 sm:line-clamp-none" data-clamp>
          {intro}
        </p>
      </div>
      <FilterBar quick={quick} menus={menus} />
    </div>
  </section>
  <div class="container-page pb-10 pt-6">
    {shown.length > 0 ? (
      <DealGrid deals={shown} placement={`city-${city.slug}`} eagerCount={2} />
    ) : (
      <EmptyDeals context={`${city.name} için şu anda yetkili kaynaklarımızdan gelen yayında bir fırsat bulunmuyor.`} />
    )}
    {cityDeals.length > shown.length && (
      <div class="mt-8 text-center">
        <a href={`/firsatlar/?sehir=${city.slug}`} class="btn-ghost">
          {city.name} için tüm {cityDeals.length} fırsatı gör
        </a>
      </div>
    )}
    <AttributionNotice deals={cityDeals} class="mt-10" />
  </div>
</BaseLayout>
