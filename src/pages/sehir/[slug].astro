---
import type { GetStaticPaths } from 'astro';
import CityPageView from '../../components/CityPageView.astro';
import { getDeals } from '../../lib/deals/repository';
import { citiesWithDeals, type CityEntry } from '../../lib/deals/taxonomy';

/** All 81 provinces (a province without deals says so instead of showing filler). */
export const getStaticPaths = (async () => {
  const { deals } = await getDeals();
  return citiesWithDeals(deals).map((city) => ({ params: { slug: city.slug }, props: { city } }));
}) satisfies GetStaticPaths;

interface Props {
  city: CityEntry;
}
const { city } = Astro.props;
---

<CityPageView city={city} page={1} />
