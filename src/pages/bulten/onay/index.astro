---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
---

<BaseLayout
  title="Aboneliğiniz onaylandı"
  description="FırsatBol bülten aboneliğiniz onaylandı. Haftanın en iyi fırsatlarını e-posta kutunuzda bulacaksınız."
  noindex
>
  <div class="container-page py-20 text-center">
    <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-save-bg text-save">
      <Icon name="mail" size={30} />
    </span>
    <h1 class="mt-6 font-display text-3xl font-extrabold">Aboneliğiniz onaylandı</h1>
    <p class="mx-auto mt-3 max-w-lg text-muted">
      Teşekkürler! Haftanın öne çıkan fırsatlarını e-postayla göndereceğiz. Her e-postadaki bağlantıyla istediğiniz zaman ayrılabilirsiniz.
    </p>
    <a href="/firsatlar/" class="btn-cta mt-8">
      Fırsatlara göz at
    </a>
  </div>
</BaseLayout>
