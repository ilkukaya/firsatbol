---
import type { GetStaticPaths } from 'astro';
import TagPageView from '../../components/TagPageView.astro';
import { getDeals } from '../../lib/deals/repository';
import { facetsOf, type SubFacet } from '../../lib/deals/facets';

/** Türkiye-wide sub-category pages: category-tree nodes (/etiket/masaj/, /etiket/spa/…) and provider tags. */
export const getStaticPaths = (async () => {
  const { deals } = await getDeals();
  return facetsOf(deals).tags.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}) satisfies GetStaticPaths;

interface Props {
  tag: SubFacet;
}
const { tag } = Astro.props;
---

<TagPageView tag={tag} page={1} />
