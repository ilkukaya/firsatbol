---
import type { GetStaticPaths } from 'astro';
import FacetView from '../../components/FacetView.astro';
import { getDeals } from '../../lib/deals/repository';
import { TOPICS } from '../../config/taxonomy';
import { facetsOf, subFacetIndexable, topicAncestorCrumbs, topicChildLinks, type SubFacet } from '../../lib/deals/facets';

/** Türkiye-wide sub-category pages: category-tree nodes (/etiket/masaj/, /etiket/spa/…) and provider tags. */
export const getStaticPaths = (async () => {
  const { deals } = await getDeals();
  return facetsOf(deals).tags.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}) satisfies GetStaticPaths;

interface Props {
  tag: SubFacet;
}
const { tag } = Astro.props;
const { deals } = await getDeals();
const { citySegments, tags } = facetsOf(deals);
const available = new Set(tags.map((t) => t.slug));
const hrefOf = (slug: string) => `/etiket/${slug}/`;
const cityLinks = citySegments
  .filter((page) => page.kind === 'tag' && page.slug === tag.slug)
  .sort((a, b) => b.deals.length - a.deals.length)
  .slice(0, 24)
  .map((page) => ({ href: `/sehir/${page.citySlug}/${page.slug}/`, label: page.cityName, count: page.deals.length }));
const crumbs = [
  { name: 'Ana sayfa', path: '/' },
  { name: 'Tüm fırsatlar', path: '/firsatlar/' },
  ...topicAncestorCrumbs(tag.topic, available, hrefOf),
  { name: tag.name, path: hrefOf(tag.slug) },
];
const root = tag.topic && tag.topic.path.length > 0 ? TOPICS.get(tag.topic.path[0]!)! : null;
---

<FacetView
  title={`${tag.name} Fırsatları ve Kampanyaları`}
  heading={`${tag.name} fırsatları`}
  eyebrow={root ? `${root.name} · Alt kategori` : tag.topic ? 'Kategori' : 'Alt kategori'}
  description={`${tag.name} fırsatları: ${tag.deals.length} güncel kampanya. Fiyat, konum ve kullanım koşullarını karşılaştırın; satıcının sayfasına güvenle geçin.`}
  deals={tag.deals}
  crumbs={crumbs}
  canonical={hrefOf(tag.slug)}
  noindex={!subFacetIndexable(tag)}
  links={[...(tag.topic ? [topicChildLinks(tag.topic, deals, available, hrefOf)] : []), { title: 'Şehirlere göre', items: cityLinks }]}
  searchTerm={tag.name}
  placement={`tag-${tag.slug}`}
/>
