---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AttributionNotice from '../components/AttributionNotice.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import DealGrid from '../components/DealGrid.astro';
import GuideCard from '../components/GuideCard.astro';
import HeroShowcase from '../components/HeroShowcase.astro';
import Icon from '../components/Icon.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TrustStrip from '../components/TrustStrip.astro';
import AdSlot from '../components/AdSlot.astro';
import { CATEGORIES } from '../config/categories';
import { SITE } from '../config/site';
import { getDeals } from '../lib/deals/repository';
import { categoryCounts, citiesWithDeals, featuredDeals, newDeals, popularDeals, upcomingEvents } from '../lib/deals/taxonomy';
import { sortEntries, toIndexEntry } from '../lib/deals/query';
import { readingMinutes } from '../lib/content';
import { websiteJsonLd } from '../lib/seo';

const { deals, generatedAt } = await getDeals();
const now = new Date(generatedAt);
const byId = new Map(deals.map((deal) => [deal.id, deal]));

// "Öne çıkan": editor-featured first; otherwise the highest *verified* discounts.
let featured = featuredDeals(deals, 8);
let featuredIsEditorial = featured.length > 0;
if (!featuredIsEditorial) {
  featured = sortEntries(deals.filter((deal) => deal.discountPercent !== null).map(toIndexEntry), 'indirim')
    .slice(0, 8)
    .map((entry) => byId.get(entry.id)!);
}
const shown = new Set(featured.map((deal) => deal.id));
const fresh = newDeals(deals, now, 8).filter((deal) => !shown.has(deal.id));
const popular = popularDeals(deals, 8);
const thisWeek = upcomingEvents(deals, now, 7, 8);

const counts = categoryCounts(deals);
// cities with deals (and the featured ones); every other province is listed on /sehirler/
const cities = citiesWithDeals(deals).filter((city) => city.count > 0 || city.featured);
const topCity = [...cities].sort((a, b) => b.count - a.count)[0];
const topCityDeals = topCity && topCity.count >= 2 ? deals.filter((deal) => deal.citySlug === topCity.slug).slice(0, 4) : [];

const categorySections = [...CATEGORIES]
  .sort((a, b) => a.homeOrder - b.homeOrder)
  .filter((category) => category.slug !== 'alisveris')
  .map((category) => ({ category, deals: deals.filter((deal) => deal.category === category.slug).slice(0, 4) }))
  .filter((section) => section.deals.length >= 2);

const guides = (await getCollection('guides', (entry) => !entry.data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 6);

// hero: three real deals with photos — breakfast, massage/spa and a getaway (popular & discounted first)
const heroScore = (deal: (typeof deals)[number]) => (deal.popular ? 2 : 0) + (deal.discountPercent ?? 0) / 50;
const heroPool = deals
  .filter((deal) => deal.imageUrl && deal.price !== null && deal.title.length <= 110)
  .sort((a, b) => heroScore(b) - heroScore(a));
const heroSlots: ((deal: (typeof deals)[number]) => boolean)[] = [
  (deal) => deal.topics.includes('kahvalti'),
  (deal) => ['hamam', 'kopuk-masaji', 'bali-masaji', 'aromaterapi-masaji', 'cift-masaji'].some((slug) => deal.topics.includes(slug)),
  (deal) => deal.category === 'tatil' && !deal.topics.includes('turlar'),
  (deal) => deal.topics.includes('tiyatro'),
];
const heroDeals: typeof deals = [];
for (const slot of heroSlots) {
  const pick = heroPool.find((deal) => slot(deal) && !heroDeals.includes(deal));
  if (pick && heroDeals.length < 3) heroDeals.push(pick);
}
for (const deal of heroPool) if (heroDeals.length < 3 && !heroDeals.includes(deal)) heroDeals.push(deal);

const quickSearches = ['Kahvaltı', 'Masaj', 'Otel', 'Konser', 'Kulaklık', 'Pilates'];
---

<BaseLayout
  title={`${SITE.name} — Güncel İndirimler, Kampanyalar ve Fırsatlar`}
  rawTitle
  description="Yeme içme, tatil, güzellik, etkinlik ve teknoloji fırsatlarını yetkili iş ortaklarından derleyen bağımsız fırsat platformu. Fırsat çok, kaçırmak yok!"
  canonical="/"
  jsonLd={[websiteJsonLd()]}
>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-line bg-[radial-gradient(1200px_500px_at_85%_-10%,#ffe4d1_0%,transparent_60%),linear-gradient(#fff,#f7f5f2)]">
    <div
      class:list={['container-page grid items-center gap-10 py-12 sm:py-16 lg:py-20', heroDeals.length > 0 && 'lg:grid-cols-[1.15fr_1fr]']}
    >
      <div>
        <h1 class="font-display text-[2.6rem] font-extrabold leading-[1.02] tracking-[-0.035em] text-ink sm:text-6xl">
          Fırsat çok,
          <br />
          <span class="text-brand-text">kaçırmak yok!</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-2">
          Yeme içmeden tatile, güzellikten etkinliklere kadar yetkili iş ortaklarımızın kampanyalarını tek yerde topluyoruz. Beğendiğiniz
          fırsatı bulun, koşullarını inceleyin, satıcının sayfasından devam edin.
        </p>
        <form action="/arama/" method="get" role="search" class="mt-7 max-w-xl" data-search-form>
          <label for="hero-search" class="sr-only">
            Ne arıyorsunuz?
          </label>
          <div class="flex items-center gap-2 rounded-full border border-line bg-white p-1.5 shadow-[var(--shadow-card)] focus-within:ring-4 focus-within:ring-brand/20">
            <Icon name="search" size={20} class="ml-3 shrink-0 text-muted" />
            <input
              id="hero-search"
              name="q"
              type="search"
              placeholder="Ne arıyorsunuz? Örn. serpme kahvaltı"
              autocomplete="off"
              enterkeyhint="search"
              class="h-11 min-w-0 flex-1 bg-transparent text-base placeholder:text-muted/80 focus:outline-none"
            />
            <button type="submit" class="btn-cta h-11 shrink-0 px-5 sm:px-6">
              Ara
            </button>
          </div>
        </form>
        <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
          <span class="font-semibold text-muted">Popüler aramalar:</span>
          {quickSearches.map((term) => (
            <a
              href={`/arama/?q=${encodeURIComponent(term)}`}
              class="rounded-full bg-white px-3 py-1 font-medium text-ink-2 ring-1 ring-line hover:ring-ink/30"
            >
              {term}
            </a>
          ))}
        </div>
        {deals.length > 0 && (
          <p class="mt-6 text-sm text-muted">
            Şu anda <strong class="text-ink">{deals.length.toLocaleString('tr-TR')}</strong> yayında fırsat ·{' '}
            {counts.size > 0 && `${[...counts.values()].filter((n) => n > 0).length} kategori`}
          </p>
        )}
      </div>

      <HeroShowcase deals={heroDeals} total={deals.length} />
    </div>
  </section>

  <div class="container-page space-y-16 py-12 sm:space-y-20 sm:py-16">
    {deals.length === 0 && (
      <section class="card overflow-hidden" aria-labelledby="akis-title">
        <div class="grid gap-6 p-6 sm:p-8 lg:grid-cols-[1.4fr_1fr] lg:items-center">
          <div>
            <p class="eyebrow mb-2">Fırsat akışı</p>
            <h2 id="akis-title" class="section-title">
              Fırsat akışımız hazırlanıyor
            </h2>
            <p class="mt-3 max-w-2xl leading-relaxed text-muted">
              FırsatBol yalnızca yetkili iş ortaklarından gelen ve doğrulanabilen fırsatları yayınlar. Veri bağlantılarımız
              etkinleştirildiğinde fırsatlar bu sayfada otomatik olarak listelenecek. Bu sırada alışveriş rehberlerimizle gerçek indirimi
              nasıl ayırt edeceğinizi öğrenebilirsiniz.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 lg:justify-end">
            <a href="/rehber/" class="btn-dark">
              Rehberleri oku
            </a>
            <a href="/firsatlarin-kaynagi/" class="btn-ghost">
              Fırsatlar nereden geliyor?
            </a>
          </div>
        </div>
      </section>
    )}

    {featured.length > 0 && (
      <section aria-labelledby="one-cikan">
        <SectionHeader
          id="one-cikan"
          eyebrow="Seçtiklerimiz"
          title="Öne Çıkan Fırsatlar"
          description={
            featuredIsEditorial
              ? 'FırsatBol tarafından öne çıkarılan fırsatlar.'
              : 'Kaynağında doğrulanabilen en yüksek indirim oranlarına sahip fırsatlar.'
          }
          href="/firsatlar/"
        />
        <DealGrid deals={featured} placement="home-featured" eagerCount={2} />
      </section>
    )}

    {thisWeek.length > 0 && (
      <section aria-labelledby="bu-hafta">
        <SectionHeader
          id="bu-hafta"

          eyebrow="Takvim"

          title="Bu Hafta Etkinlikler"

          description="Önümüzdeki 7 gün içinde seansı olan tiyatro, konser, stand-up ve aktiviteler."

          href="/kategori/etkinlik/"
        />

        <DealGrid deals={thisWeek} placement="home-this-week" />
      </section>
    )}

    {fresh.length > 0 && (
      <section aria-labelledby="yeni">
        <SectionHeader
          id="yeni"
          eyebrow="Taze"
          title="Yeni Eklenen Fırsatlar"
          description="Son günlerde başlayan kampanyalar."
          href="/firsatlar/?sirala=yeni"
        />
        <DealGrid deals={fresh} placement="home-new" />
      </section>
    )}

    {popular.length > 0 && (
      <section aria-labelledby="populer">
        <SectionHeader
          id="populer"
          eyebrow="İlgi görenler"
          title="Popüler Fırsatlar"
          description="İş ortağımızın “çok satan” olarak işaretlediği fırsatlar."
          href="/firsatlar/"
        />
        <DealGrid deals={popular} placement="home-popular" />
      </section>
    )}

    <AdSlot id="home-mid" />

    <section aria-labelledby="sehir">
      <SectionHeader
        id="sehir"
        eyebrow="Yakınınızda"
        title="Şehrindeki Fırsatlar"
        description="Şehrinizi seçin; restoran, spa, etkinlik ve aktivite fırsatlarını konuma göre görün."
      />
      <ul class="flex flex-wrap gap-2.5">
        {cities.map((city) => (
          <li>
            <a href={`/sehir/${city.slug}/`} class="chip px-4 py-2 text-[0.95rem]">
              <Icon name="pin" size={16} class="text-brand-text" />
              {city.name}
              {city.count > 0 && <span class="rounded-full bg-canvas px-2 text-xs font-bold text-muted">{city.count}</span>}
            </a>
          </li>
        ))}
      </ul>
      {topCity && topCityDeals.length > 0 && (
        <div class="mt-8">
          <h3 class="mb-4 text-lg font-bold">
            {topCity.name} fırsatları{' '}
            <a href={`/sehir/${topCity.slug}/`} class="ml-2 text-sm font-bold text-brand-text hover:underline">
              Tümü →
            </a>
          </h3>
          <DealGrid deals={topCityDeals} placement="home-city" />
        </div>
      )}
    </section>

    <section aria-labelledby="kategoriler">
      <SectionHeader id="kategoriler" eyebrow="Keşfet" title="Kategorilere Göz Atın" />
      <CategoryGrid counts={counts} />
    </section>

    {categorySections.map(({ category, deals: sectionDeals }) => (
      <section aria-labelledby={`kat-${category.slug}`}>
        <SectionHeader id={`kat-${category.slug}`} title={category.homeTitle} href={`/kategori/${category.slug}/`} />
        <DealGrid deals={sectionDeals} placement={`home-cat-${category.slug}`} />
      </section>
    ))}

    <section aria-labelledby="rehberler">
      <SectionHeader
        id="rehberler"
        eyebrow="Akıllı alışveriş"
        title="Alışveriş Rehberleri"
        description="Gerçek indirimi ayırt etmek, kupon koşullarını okumak ve iade haklarınızı bilmek için pratik rehberler."
        href="/rehber/"
      />
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {guides.map((guide) => (
          <GuideCard
            title={guide.data.title}
            description={guide.data.description}
            href={`/rehber/${guide.id}/`}
            minutes={readingMinutes(guide.body ?? '')}
          />
        ))}
      </div>
    </section>

    <NewsletterForm />

    <section aria-labelledby="guven" class="rounded-[1.5rem] bg-sand/70 p-6 sm:p-10">
      <div class="mb-8 grid gap-4 lg:grid-cols-[1fr_1.2fr] lg:items-end">
        <div>
          <p class="eyebrow mb-2">Neden FırsatBol?</p>
          <h2 id="guven" class="section-title">
            Güvenilir bilgi, şeffaf iş ortaklığı
          </h2>
        </div>
        <p class="leading-relaxed text-ink-2">
          Satış yapmıyoruz; fırsatları kaynağından aldığımız bilgilerle gösterir, sizi satıcıya yönlendiririz. Nasıl çalıştığımızı{' '}
          <a href="/editoryal-ilkeler/" class="font-semibold text-brand-text underline underline-offset-2">
            editoryal ilkelerimizde
          </a>{' '}
          ve{' '}
          <a href="/is-ortakligi-aciklamasi/" class="font-semibold text-brand-text underline underline-offset-2">
            iş ortaklığı açıklamamızda
          </a>{' '}
          anlatıyoruz.
        </p>
      </div>
      <TrustStrip />
    </section>

    <AttributionNotice deals={deals} />
  </div>
</BaseLayout>
