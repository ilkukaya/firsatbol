---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AttributionNotice from '../../components/AttributionNotice.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DealGrid from '../../components/DealGrid.astro';
import Icon from '../../components/Icon.astro';
import DealGallery from '../../components/DealGallery.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getCategory } from '../../config/categories';
import { getDeals } from '../../lib/deals/repository';
import type { Deal } from '../../lib/deals/schema';
import { relatedDeals } from '../../lib/deals/taxonomy';
import { formatDate, formatDateTime, formatPrice, formatSessionLong } from '../../lib/format';
import { breadcrumbJsonLd } from '../../lib/seo';
import { facetsOf, tagSlug } from '../../lib/deals/facets';
import { TOPICS } from '../../config/taxonomy';

export const getStaticPaths = (async () => {
  const { deals } = await getDeals();
  return deals.map((deal) => ({ params: { slug: deal.slug }, props: { deal } }));
}) satisfies GetStaticPaths;

interface Props {
  deal: Deal;
}
const { deal } = Astro.props;
const { deals } = await getDeals();
const category = getCategory(deal.category);
const related = relatedDeals(deal, deals, 4);
const facets = facetsOf(deals);
const tagPages = new Set(facets.tags.map((tag) => tag.slug));
// category-tree nodes first (deepest first: "Köpük masajı" before "Masaj"), then the deal's other tags
const tagLinks = [
  ...[...deal.topics].reverse().map((slug) => ({ slug, name: TOPICS.get(slug)?.name ?? slug })),
  ...deal.tags.map((tag) => ({ slug: tagSlug(tag), name: tag })),
]
  .filter((tag, index, all) => tagPages.has(tag.slug) && all.findIndex((t) => t.slug === tag.slug) === index)
  .slice(0, 16);
const districtPage =
  deal.citySlug && deal.district ? facets.districts.find((d) => d.citySlug === deal.citySlug && d.name === deal.district) : undefined;
const location = [deal.district, deal.city].filter(Boolean).join(', ');
const showOriginal = deal.originalPrice !== null && deal.price !== null && deal.originalPrice > deal.price;
const saving = showOriginal ? deal.originalPrice! - deal.price! : null;

// Selectable options: each carries the partner's own tracked checkout link (subDeal), so the chosen
// option opens directly on the partner's page via the transition page (/git/<slug>/?secenek=<id>).
const choices = deal.options
  .filter((option) => option.id && option.url && option.price !== null)
  .map((option) => {
    const original = option.originalPrice !== null && option.originalPrice > option.price! ? option.originalPrice : null;
    const percent = original ? Math.floor(((original - option.price!) / original) * 100) : 0;
    return {
      id: option.id!,
      title: option.title,
      price: option.price!,
      priceLabel: formatPrice(option.price!, deal.currency),
      originalLabel: original ? formatPrice(original, deal.currency) : '',
      savingLabel: original ? `${formatPrice(original - option.price!, deal.currency)} tasarruf` : '',
      percent: percent >= 1 ? percent : null,
    };
  });
const picker = choices.length >= 2;
const initial = picker ? (choices.find((choice) => choice.price === deal.price) ?? choices[0]!) : undefined;
const shownPercent = initial ? initial.percent : deal.discountPercent;
const shownOriginal = initial ? initial.originalLabel : showOriginal ? formatPrice(deal.originalPrice!, deal.currency) : '';
const shownSaving = initial ? initial.savingLabel : saving !== null ? `${formatPrice(saving, deal.currency)} tasarruf` : '';
const shownPrice = initial ? initial.priceLabel : deal.price !== null ? formatPrice(deal.price, deal.currency) : '';
const ctaHref = initial ? `/git/${deal.slug}/?secenek=${encodeURIComponent(initial.id)}` : `/git/${deal.slug}/`;

const crumbs = [
  { name: 'Ana sayfa', path: '/' },
  ...(category ? [{ name: category.name, path: `/kategori/${category.slug}/` }] : []),
  ...(deal.citySlug && deal.city ? [{ name: deal.city, path: `/sehir/${deal.citySlug}/` }] : []),
  { name: deal.title, path: `/firsat/${deal.slug}/` },
];

const fallbackDescription = [
  deal.merchant ? `${deal.merchant} fırsatı` : 'Fırsat',
  location ? `(${location})` : '',
  deal.price !== null ? `— ${formatPrice(deal.price, deal.currency)}` : '',
  '. Fiyat, geçerlilik tarihi ve kullanım koşullarını inceleyin.',
]
  .join(' ')
  .replace(/\s+\./, '.')
  .replace(/\s+/g, ' ')
  .trim();
const metaSource = deal.summary ?? deal.description;
const metaDescription = metaSource
  ? metaSource
      .replace(/\s+/g, ' ')
      .slice(0, 155)
      .replace(/\s\S*$/, '') + '…'
  : fallbackDescription;
const metaTitle = `${deal.title}${deal.city && !deal.title.includes(deal.city) ? ` — ${deal.city}` : ''}`;
const descriptionParagraphs = (deal.description ?? '').split(/\n{2,}|\n/).filter((line) => line.trim().length > 0);
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical={`/firsat/${deal.slug}/`}
  noindex={!deal.indexable}
  ogImage={deal.imageLargeUrl ?? deal.imageUrl ?? undefined}
  jsonLd={[breadcrumbJsonLd(crumbs)]}
>
  <div
    class="container-page py-8 sm:py-10"
    data-deal-view
    data-deal-id={deal.id}
    data-provider={deal.provider}
    data-category={deal.category}
  >
    <Breadcrumbs crumbs={crumbs} />

    <div class="mt-6 grid gap-8 lg:grid-cols-[1.45fr_1fr] lg:items-start" data-valid-until={deal.validUntil ?? undefined}>
      <div class="min-w-0">
        <DealGallery
          images={deal.images.length ? deal.images : deal.imageUrl ? [deal.imageUrl] : []}
          title={deal.title}
          fallbackIcon={category?.icon ?? 'tag'}
        />

        <div class="mt-6">
          <div class="flex flex-wrap items-center gap-2 text-sm">
            {category && (
              <a href={`/kategori/${category.slug}/`} class="rounded-full bg-brand-50 px-3 py-1 font-semibold text-brand-text">
                {category.name}
              </a>
            )}
            {deal.city && deal.citySlug && (
              <a href={`/sehir/${deal.citySlug}/`} class="rounded-full bg-white px-3 py-1 font-semibold text-ink-2 ring-1 ring-line">
                {deal.city}
              </a>
            )}
          </div>
          <h1 class="mt-3 font-display text-[1.9rem] font-extrabold leading-tight tracking-tight sm:text-4xl">{deal.title}</h1>
          {deal.merchant && (
            <p class="mt-2 flex items-center gap-1.5 text-ink-2">
              <Icon name="store" size={18} class="text-muted" />
              {deal.merchant}
            </p>
          )}
          {(deal.address ?? location) && (
            <p class="mt-1 flex items-start gap-1.5 text-ink-2">
              <Icon name="pin" size={18} class="mt-0.5 shrink-0 text-muted" />
              <span>{deal.address ?? location}</span>
            </p>
          )}
        </div>

        {deal.sessions.length > 0 && (
          <section class="mt-8" aria-labelledby="takvim">
            <h2 id="takvim" class="font-display text-xl font-bold">
              Etkinlik takvimi
            </h2>

            <ul class="mt-3 divide-y divide-line overflow-hidden rounded-2xl border border-line bg-white">
              {deal.sessions.map((session) => (
                <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-3">
                  <span class="min-w-0">
                    <span class="block font-semibold text-ink">{formatSessionLong(session.date)}</span>

                    <span class="block text-sm text-muted">
                      {[session.venue, session.district, session.city].filter(Boolean).join(' · ')}
                    </span>
                  </span>

                  <span class="shrink-0 text-right">
                    {session.originalPrice !== null && (
                      <span class="block text-xs text-muted line-through">
                        <span class="sr-only">Önceki fiyat:</span>

                        {formatPrice(session.originalPrice, deal.currency)}
                      </span>
                    )}

                    {session.price !== null && <span class="font-bold text-ink">{formatPrice(session.price, deal.currency)}</span>}
                  </span>
                </li>
              ))}
            </ul>

            <p class="mt-2 text-xs text-muted">
              Seans bilgileri Fırsat Bu Fırsat Etkinlik API’sinden alınmıştır; koltuk ve seans durumunu satıcı sayfasında kontrol edin.
            </p>
          </section>
        )}

        {deal.options.length > 0 && (
          <section class="mt-8" aria-labelledby="secenekler">
            <h2 id="secenekler" class="font-display text-xl font-bold">
              Seçenekler
            </h2>
            <ul class="mt-3 divide-y divide-line overflow-hidden rounded-2xl border border-line bg-white">
              {deal.options.map((option) => (
                <li class="flex items-center justify-between gap-4 px-4 py-3">
                  <span class="text-[0.95rem] text-ink-2">{option.title}</span>
                  <span class="shrink-0 text-right">
                    {option.originalPrice !== null && (
                      <span class="block text-xs text-muted line-through">
                        <span class="sr-only">Önceki fiyat:</span>
                        {formatPrice(option.originalPrice, deal.currency)}
                      </span>
                    )}
                    {option.price !== null ? (
                      <span class="font-bold text-ink">{formatPrice(option.price, deal.currency)}</span>
                    ) : (
                      <span class="text-sm text-muted">Satıcı sayfasında</span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
            <p class="mt-2 text-xs text-muted">Seçenek fiyatları kaynağından alınmıştır; güncel fiyatı satıcı sayfasında kontrol edin.</p>
          </section>
        )}

        {deal.summary && (
          <section class="mt-8 rounded-2xl border-l-4 border-brand bg-white p-5 ring-1 ring-line" aria-labelledby="editor-ozeti">
            <h2 id="editor-ozeti" class="eyebrow">
              FırsatBol özeti
            </h2>
            <p class="mt-2 leading-relaxed text-ink-2">{deal.summary}</p>
          </section>
        )}

        {descriptionParagraphs.length > 0 && (
          <section class="mt-8" aria-labelledby="aciklama">
            <h2 id="aciklama" class="font-display text-xl font-bold">
              Fırsat açıklaması
            </h2>
            <div class="prose-fb mt-3">
              {descriptionParagraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
            {deal.provider !== 'editorial' && (
              <p class="mt-3 text-xs text-muted">Açıklama metni {deal.providerName} tarafından sağlanmıştır.</p>
            )}
          </section>
        )}

        {deal.conditions.length > 0 && (
          <section class="mt-8" aria-labelledby="kosullar">
            <h2 id="kosullar" class="font-display text-xl font-bold">
              Kullanım koşulları
            </h2>
            <ul class="mt-3 grid gap-2">
              {deal.conditions.map((condition) => (
                <li class="flex gap-2.5 text-ink-2">
                  <Icon name="check" size={18} class="mt-0.5 shrink-0 text-save" />
                  <span>{condition}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
        {(tagLinks.length > 0 || districtPage) && (
          <nav class="mt-8" aria-label="İlgili sayfalar">
            <ul class="flex flex-wrap gap-2">
              {districtPage && (
                <li>
                  <a href={`/sehir/${districtPage.citySlug}/${districtPage.slug}/`} class="chip">
                    <Icon name="pin" size={14} class="text-brand-text" />
                    {districtPage.name} fırsatları
                  </a>
                </li>
              )}
              {tagLinks.map((tag) => (
                <li>
                  <a href={`/etiket/${tag.slug}/`} class="chip">
                    <Icon name="tag" size={14} class="text-brand-text" />
                    {tag.name}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <section class="mt-8 rounded-2xl bg-sand/70 p-5" aria-labelledby="kontrol">
          <h2 id="kontrol" class="font-bold">
            Satın almadan önce
          </h2>
          <ul class="mt-2 grid gap-1.5 text-sm text-ink-2">
            <li>• Güncel fiyatı ve stok/kontenjan durumunu satıcı sayfasında doğrulayın.</li>
            <li>• Geçerli gün, saat ve şube bilgisini kontrol edin; rezervasyon gerekip gerekmediğine bakın.</li>
            <li>• İptal, iade ve kullanım şartlarını satın almadan önce okuyun.</li>
          </ul>
          <a
            href="/rehber/kampanya-sartlari-nasil-kontrol-edilir/"
            class="mt-3 inline-block text-sm font-bold text-brand-text hover:underline"
          >
            Kampanya şartları nasıl kontrol edilir? →
          </a>
        </section>
      </div>

      <aside class="lg:sticky lg:top-36" aria-label="Fırsat özeti">
        <div class="card p-5 sm:p-6">
          <p data-expired-note class="mb-4 hidden rounded-xl bg-ink px-3 py-2 text-sm font-semibold text-white">
            Bu fırsatın geçerlilik süresi dolmuş görünüyor. Güncel durumu satıcı sayfasında kontrol edin.
          </p>
          <p
            class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-save-bg px-3 py-1 text-sm font-extrabold text-save"
            hidden={shownPercent === null}
            data-choice-percent-wrap
          >
            <Icon name="percent" size={15} />%<span data-choice-percent>{shownPercent}</span> indirim
          </p>
          {shownPrice ? (
            <div>
              <p class="text-muted" hidden={!shownOriginal} data-choice-original-wrap>
                <span class="sr-only">Önceki fiyat: </span>
                <span class="line-through" data-choice-original>
                  {shownOriginal}
                </span>
              </p>
              <p class="font-display text-4xl font-extrabold tracking-tight" data-choice-price aria-live="polite">
                {shownPrice}
              </p>
              <p class="mt-1 text-sm font-semibold text-save" hidden={!shownSaving} data-choice-saving>
                {shownSaving}
              </p>
            </div>
          ) : (
            <p class="text-lg font-semibold text-ink-2">Fiyat bilgisi satıcı sayfasında yer alır.</p>
          )}

          {picker && (
            <fieldset class="mt-5 border-t border-line pt-4" data-option-picker>
              <legend class="flex w-full items-baseline justify-between text-xs font-bold uppercase tracking-wider text-muted">
                Seçeneğinizi belirleyin <span class="font-semibold normal-case tracking-normal">{choices.length} seçenek</span>
              </legend>
              <div class="mt-3 grid max-h-80 gap-2 overflow-y-auto overscroll-contain pr-1">
                {choices.map((choice) => (
                  <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-line bg-white p-3 transition hover:border-ink/30 has-[:checked]:border-cta has-[:checked]:bg-brand-50 has-[:checked]:ring-1 has-[:checked]:ring-cta has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-brand">
                    <input
                      type="radio"
                      name="secenek"
                      value={choice.id}
                      checked={choice.id === initial!.id}
                      class="h-4 w-4 shrink-0 accent-[var(--color-cta)]"
                      data-price={choice.priceLabel}
                      data-original={choice.originalLabel}
                      data-saving={choice.savingLabel}
                      data-percent={choice.percent ?? ''}
                    />
                    <span class="min-w-0 flex-1 text-sm font-medium leading-snug text-ink">{choice.title}</span>
                    <span class="shrink-0 text-right leading-tight">
                      {choice.originalLabel && <s class="block text-xs text-muted">{choice.originalLabel}</s>}
                      <span class="text-sm font-extrabold text-ink">{choice.priceLabel}</span>
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
          )}

          <dl class="mt-5 grid gap-2.5 border-t border-line pt-4 text-sm">
            {deal.validFrom && (
              <div class="flex justify-between gap-4">
                <dt class="text-muted">Başlangıç</dt>
                <dd class="font-semibold">{formatDate(deal.validFrom)}</dd>
              </div>
            )}
            {deal.sessions[0] && (
              <div class="flex justify-between gap-4">
                <dt class="text-muted">Sonraki seans</dt>
                <dd class="text-right font-semibold">{formatDateTime(deal.sessions[0].date)}</dd>
              </div>
            )}
            {deal.validUntil && (
              <div class="flex justify-between gap-4">
                <dt class="text-muted">Son kullanım</dt>
                <dd class="font-semibold">{formatDate(deal.validUntil)}</dd>
              </div>
            )}
            <div class="flex justify-between gap-4">
              <dt class="text-muted">Kaynak</dt>
              <dd class="font-semibold">{deal.providerName}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-muted">Son kontrol</dt>
              <dd class="font-semibold">{formatDateTime(deal.lastCheckedAt)}</dd>
            </div>
          </dl>

          <a
            href={ctaHref}
            target="_blank"
            rel="nofollow"
            class="deal-cta btn-cta mt-5 w-full py-3.5 text-base"
            data-deal-link
            data-deal-id={deal.id}
            data-provider={deal.provider}
            data-category={deal.category}
            data-city={deal.citySlug ?? undefined}
            data-placement="detail"
            data-choice-cta={`/git/${deal.slug}/`}
          >
            Fırsatı Gör
            {picker && (
              <span class="rounded-full bg-white px-2 py-0.5 text-sm font-extrabold text-cta-hover" data-choice-cta-price>
                {initial!.priceLabel}
              </span>
            )}
            <Icon name="external" size={18} />
          </a>
          <p class="mt-2 text-center text-xs text-muted">{deal.merchant ?? deal.providerName} sayfası yeni sekmede açılır.</p>

          <p class="mt-5 rounded-xl bg-canvas p-3 text-xs leading-relaxed text-ink-2">
            {deal.affiliateUrl
              ? 'Bu bağlantı bir iş ortaklığı bağlantısıdır; bu bağlantı üzerinden yapılan işlemlerden FırsatBol komisyon kazanabilir. Ödediğiniz fiyat değişmez.'
              : 'Bu bağlantı satıcının sayfasına gider.'}{' '}
            Satış, ödeme ve iade işlemleri satıcı ile aranızdadır.{' '}
            <a href="/is-ortakligi-aciklamasi/" class="font-semibold underline">
              Ayrıntılar
            </a>
          </p>
        </div>
        <AttributionNotice deals={[deal]} class="mt-4" />
        <p class="mt-3 px-1 text-xs text-muted">
          Fırsat kimliği: <code>{deal.id}</code> · Hatalı bilgi mi gördünüz?{' '}
          <a href="/iletisim/" class="underline">
            Bize bildirin
          </a>
          .
        </p>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="mt-16" aria-labelledby="benzer">
        <SectionHeader id="benzer" title="Benzer fırsatlar" href={category ? `/kategori/${category.slug}/` : '/firsatlar/'} />
        <DealGrid deals={related} placement="detail-related" />
      </section>
    )}
  </div>
  <script>
    // option picker: the selected option's price, saving and discount are shown and the CTA opens
    // the transition page for exactly that option (/git/<slug>/?secenek=<id>)
    const picker = document.querySelector<HTMLFieldSetElement>('[data-option-picker]');
    const cta = document.querySelector<HTMLAnchorElement>('[data-choice-cta]');
    if (picker && cta) {
      const set = (selector: string, text: string) => {
        const el = document.querySelector<HTMLElement>(selector);
        if (el) el.textContent = text;
      };
      const show = (selector: string, visible: boolean) => {
        const el = document.querySelector<HTMLElement>(selector);
        if (el) el.hidden = !visible;
      };
      picker.addEventListener('change', (event) => {
        const input = event.target as HTMLInputElement;
        if (input.name !== 'secenek') return;
        const { price = '', original = '', saving = '', percent = '' } = input.dataset;
        set('[data-choice-price]', price);
        set('[data-choice-original]', original);
        show('[data-choice-original-wrap]', original !== '');
        set('[data-choice-saving]', saving);
        show('[data-choice-saving]', saving !== '');
        set('[data-choice-percent]', percent);
        show('[data-choice-percent-wrap]', percent !== '');
        set('[data-choice-cta-price]', price);
        cta.href = `${cta.dataset.choiceCta}?secenek=${encodeURIComponent(input.value)}`;
      });
    }
  </script>
</BaseLayout>
