---
import type { GetStaticPaths } from 'astro';
import RedirectLayout from '../../layouts/RedirectLayout.astro';
import AttributionNotice from '../../components/AttributionNotice.astro';
import Icon from '../../components/Icon.astro';
import Logo from '../../components/Logo.astro';
import { getDeals } from '../../lib/deals/repository';
import type { Deal } from '../../lib/deals/schema';
import { formatPrice } from '../../lib/format';

/**
 * Short, transparent transition page between FırsatBol and the partner's deal page.
 * It shows exactly where the visitor is going, then forwards after a few seconds
 * (or immediately via the button). The partner's referral URL is used unchanged.
 * noindex + Disallow in robots.txt; never listed in the sitemap.
 */
export const getStaticPaths = (async () => {
  const { deals } = await getDeals();
  return deals.map((deal) => ({ params: { slug: deal.slug }, props: { deal } }));
}) satisfies GetStaticPaths;

interface Props {
  deal: Deal;
}
const { deal } = Astro.props;
const target = deal.affiliateUrl ?? deal.sourceUrl;
const host = new URL(target).hostname.replace(/^www\./, '');
const isAffiliate = deal.affiliateUrl !== null;
const destination = deal.providerName === 'FırsatBol Editör' ? (deal.merchant ?? host) : deal.providerName;
const seconds = 3;
---

<RedirectLayout
  title={`${destination} sayfasına yönlendiriliyorsunuz`}
  description={`${deal.title} fırsatı için ${destination} sayfasına güvenli yönlendirme. Satın alma ve ödeme ${destination} üzerinde yapılır.`}
  canonical={`/firsat/${deal.slug}/`}
>
  <noscript slot="head">
    <meta http-equiv="refresh" content={`${seconds};url=${target}`} />
  </noscript>

  <main
    class="mx-auto flex min-h-dvh max-w-lg flex-col items-center justify-center px-4 py-10 text-center"
    data-redirect={target}
    data-seconds={seconds}
    data-deal-id={deal.id}
    data-provider={deal.provider}
    data-category={deal.category}
  >
    <a href="/" class="rounded-lg" aria-label="FırsatBol ana sayfa">
      <Logo />
    </a>

    <div class="card mt-8 w-full overflow-hidden text-left">
      <div class="flex items-center gap-4 p-4">
        {deal.imageUrl ? (
          <img src={deal.imageUrl} alt="" width="88" height="88" class="h-20 w-20 shrink-0 rounded-xl object-cover" />
        ) : (
          <span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-text">
            <Icon name="tag" size={30} />
          </span>
        )}
        <div class="min-w-0">
          {deal.merchant && <p class="truncate text-xs font-semibold text-muted">{deal.merchant}</p>}
          <p class="line-clamp-2 font-bold leading-snug text-ink">{deal.title}</p>
          {deal.price !== null && (
            <p class="mt-1 text-sm">
              {deal.priceFrom && <span class="text-muted">Başlangıç fiyatı </span>}
              <strong class="text-ink">{formatPrice(deal.price, deal.currency)}</strong>
              {deal.discountPercent !== null && (
                <span class="ml-2 rounded-full bg-save-bg px-2 py-0.5 text-xs font-bold text-save">%{deal.discountPercent} indirim</span>
              )}
            </p>
          )}
        </div>
      </div>
      <div class="h-1.5 bg-sand" aria-hidden="true">
        <div class="h-full w-0 bg-cta transition-[width] ease-linear" data-progress></div>
      </div>
    </div>

    <h1 class="mt-8 font-display text-2xl font-extrabold leading-tight tracking-tight sm:text-3xl">Fırsatınız hazır!</h1>
    <p class="mt-3 text-[1.02rem] leading-relaxed text-ink-2">
      Sizi <strong class="text-ink">{destination}</strong> üzerindeki fırsat sayfasına güvenle yönlendiriyoruz.
      <span class="block text-sm text-muted" aria-live="polite" data-countdown>
        {seconds} saniye içinde otomatik olarak açılacak.
      </span>
    </p>

    <a href={target} rel={isAffiliate ? 'sponsored nofollow' : 'nofollow'} class="btn-cta mt-6 w-full py-3.5 text-base" data-redirect-now>
      Hemen fırsata git
      <Icon name="arrow-right" size={18} />
    </a>
    <a
      href={`/firsat/${deal.slug}/`}
      class="mt-3 text-sm font-semibold text-muted underline-offset-4 hover:text-ink hover:underline"
      data-redirect-cancel
    >
      Vazgeç, fırsat detayına dön
    </a>

    <ul class="mt-8 grid w-full gap-2.5 rounded-2xl bg-white/80 p-4 text-left text-sm text-ink-2 ring-1 ring-line">
      <li class="flex gap-2.5">
        <Icon name="shield" size={18} class="mt-0.5 shrink-0 text-save" />
        <span>
          Gideceğiniz adres: <strong class="text-ink">{host}</strong>
        </span>
      </li>
      <li class="flex gap-2.5">
        <Icon name="check" size={18} class="mt-0.5 shrink-0 text-save" />
        <span>Satın alma ve ödeme {destination} sayfasında yapılır; FırsatBol ödeme bilgisi almaz.</span>
      </li>
      <li class="flex gap-2.5">
        <Icon name="info" size={18} class="mt-0.5 shrink-0 text-save" />
        <span>Güncel fiyat, stok ve koşullar satıcı sayfasında geçerlidir.</span>
      </li>
    </ul>
    {isAffiliate && <p class="mt-4 text-xs leading-relaxed text-muted">Bu bir iş ortaklığı bağlantısıdır; ödediğiniz fiyat değişmez.</p>}
    <AttributionNotice deals={[deal]} class="mt-4 w-full" />
  </main>

  <script>
    const root = document.querySelector<HTMLElement>('[data-redirect]');
    if (root) {
      const target = root.dataset.redirect!;
      const total = Number(root.dataset.seconds ?? '3');
      const countdown = root.querySelector<HTMLElement>('[data-countdown]');
      const progress = root.querySelector<HTMLElement>('[data-progress]');
      let remaining = total;
      let cancelled = false;
      const go = () => {
        if (!cancelled) location.replace(target);
      };
      requestAnimationFrame(() => {
        if (progress) {
          progress.style.transitionDuration = `${total}s`;
          progress.style.width = '100%';
        }
      });
      const timer = window.setInterval(() => {
        remaining -= 1;
        if (remaining <= 0) {
          window.clearInterval(timer);
          go();
        } else if (countdown) countdown.textContent = `${remaining} saniye içinde otomatik olarak açılacak.`;
      }, 1000);
      root.querySelector('[data-redirect-cancel]')?.addEventListener('click', () => {
        cancelled = true;
        window.clearInterval(timer);
      });
    }
  </script>
</RedirectLayout>
