---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideCard from '../../components/GuideCard.astro';
import { readingMinutes } from '../../lib/content';
import { breadcrumbJsonLd, itemListJsonLd } from '../../lib/seo';

const guides = (await getCollection('guides', (entry) => !entry.data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const crumbs = [
  { name: 'Ana sayfa', path: '/' },
  { name: 'Alışveriş rehberleri', path: '/rehber/' },
];
---

<BaseLayout
  title="Alışveriş Rehberleri: Akıllı ve Güvenli Alışveriş İpuçları"
  description="Gerçek indirimi anlamak, kupon kodlarını doğru kullanmak, kargo ve iade koşullarını bilmek için FırsatBol’un pratik ve tarafsız alışveriş rehberleri."
  jsonLd={[
    breadcrumbJsonLd(crumbs),
    itemListJsonLd(
      'Alışveriş rehberleri',
      guides.map((g) => ({ name: g.data.title, path: `/rehber/${g.id}/` })),
    ),
  ]}
>
  <div class="container-page py-8 sm:py-12">
    <Breadcrumbs crumbs={crumbs} />
    <div class="mb-8 mt-5 max-w-3xl">
      <p class="eyebrow mb-2">Akıllı alışveriş</p>
      <h1 class="font-display text-3xl font-extrabold tracking-tight sm:text-[2.6rem]">Alışveriş rehberleri</h1>
      <p class="mt-3 text-[1.05rem] leading-relaxed text-ink-2">
        İndirim etiketlerinin arkasına bakmak, kampanya şartlarını doğru okumak ve tüketici haklarınızı bilmek için hazırladığımız
        rehberler. Hiçbiri sponsorlu değildir.
      </p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {guides.map((guide) => (
        <GuideCard
          title={guide.data.title}
          description={guide.data.description}
          href={`/rehber/${guide.id}/`}
          minutes={readingMinutes(guide.body ?? '')}
        />
      ))}
    </div>
  </div>
</BaseLayout>
