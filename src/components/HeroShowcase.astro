---
/**
 * Homepage hero visual: real deals from the current build (the partner's own photos, prices and
 * locations), not an illustration. Each card links to its deal page.
 */
import Icon from './Icon.astro';
import type { Deal } from '../lib/deals/schema';
import { formatPrice } from '../lib/format';

interface Props {
  deals: readonly Deal[];
  total: number;
}
const { deals, total } = Astro.props;

const location = (deal: Deal) => [deal.district, deal.city].filter(Boolean).join(', ') || 'Türkiye geneli';
const [main, side, small] = deals;
---

{main && (
  <div class="relative mx-auto hidden h-[30rem] w-full max-w-md lg:block">
    <div class="absolute inset-x-6 inset-y-8 rounded-[2.5rem] bg-sand ring-1 ring-line" aria-hidden="true" />

    <p class="absolute right-2 top-0 z-30 inline-flex items-center gap-2 rounded-full bg-white px-3 py-1.5 text-xs font-bold text-ink shadow-[var(--shadow-card)] ring-1 ring-line">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full rounded-full bg-save opacity-60 motion-safe:animate-ping" />
        <span class="relative inline-flex h-2 w-2 rounded-full bg-save" />
      </span>
      Şu an yayında: {total.toLocaleString('tr-TR')} fırsat
    </p>

    <a
      href={`/firsat/${main.slug}/`}
      class="group absolute left-0 top-8 z-20 w-[56%] -rotate-3 overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-lift)] ring-1 ring-line transition motion-safe:hover:-translate-y-1 motion-safe:hover:rotate-0"
    >
      <div class="relative aspect-[4/3] bg-sand">
        <img
          src={main.imageUrl!}
          alt=""
          width="400"
          height="300"
          class="h-full w-full object-cover"
          fetchpriority="high"
          decoding="async"
        />
        {main.discountPercent !== null && (
          <span class="absolute left-3 top-3 rounded-full bg-save px-2.5 py-1 text-xs font-extrabold text-white">
            %{main.discountPercent} indirim
          </span>
        )}
      </div>
      <div class="p-3.5">
        <p class="flex items-center gap-1 text-xs font-semibold text-muted">
          <Icon name="pin" size={13} class="text-brand-text" />
          {location(main)}
        </p>
        <p class="mt-1 line-clamp-2 text-sm font-bold leading-snug text-ink group-hover:text-brand-text">{main.title}</p>
        <p class="mt-2 flex items-baseline gap-2">
          {main.originalPrice !== null && <s class="text-xs text-muted">{formatPrice(main.originalPrice, main.currency)}</s>}
          <span class="text-lg font-extrabold tracking-tight text-ink">
            {main.priceFrom && <span class="text-xs font-semibold text-muted">başlayan </span>}
            {formatPrice(main.price!, main.currency)}
          </span>
        </p>
      </div>
    </a>

    {side && (
      <a
        href={`/firsat/${side.slug}/`}
        class="group absolute right-0 top-20 z-10 w-[41%] rotate-[4deg] overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-lift)] ring-1 ring-line transition motion-safe:hover:-translate-y-1 motion-safe:hover:rotate-0"
      >
        <div class="relative aspect-square bg-sand">
          <img src={side.imageUrl!} alt="" width="300" height="300" class="h-full w-full object-cover" decoding="async" />
          {side.discountPercent !== null && (
            <span class="absolute left-2.5 top-2.5 rounded-full bg-save px-2 py-0.5 text-[0.7rem] font-extrabold text-white">
              %{side.discountPercent}
            </span>
          )}
        </div>
        <div class="p-3">
          <p class="line-clamp-2 text-xs font-bold leading-snug text-ink group-hover:text-brand-text">{side.title}</p>
          <p class="mt-1.5 text-sm font-extrabold text-ink">{formatPrice(side.price!, side.currency)}</p>
        </div>
      </a>
    )}

    {small && (
      <a
        href={`/firsat/${small.slug}/`}
        class="group absolute bottom-1 left-[12%] z-30 flex w-[76%] -rotate-1 items-center gap-3 rounded-2xl bg-white p-2.5 shadow-[var(--shadow-lift)] ring-1 ring-line transition motion-safe:hover:-translate-y-1 motion-safe:hover:rotate-0"
      >
        <img
          src={small.imageUrl!}
          alt=""
          width="64"
          height="64"
          class="h-16 w-16 shrink-0 rounded-xl bg-sand object-cover"
          decoding="async"
        />
        <span class="min-w-0">
          <span class="block truncate text-xs font-semibold text-muted">{location(small)}</span>
          <span class="line-clamp-2 text-xs font-bold leading-snug text-ink group-hover:text-brand-text">{small.title}</span>
          <span class="mt-0.5 block text-sm font-extrabold text-ink">{formatPrice(small.price!, small.currency)}</span>
        </span>
      </a>
    )}
  </div>
)}
