---
/** City page (/sehir/<city>/ and its /sayfa/<n>/ pages). */
import FacetView from './FacetView.astro';
import { CATEGORIES } from '../config/categories';
import { getDeals } from '../lib/deals/repository';
import { guidesFor } from '../lib/guides';
import { MIN_CITY_INDEX, MIN_COMBO_PAGE, countBy, type CityEntry } from '../lib/deals/taxonomy';
import { sortEntries, toIndexEntry } from '../lib/deals/query';
import { facetsOf, rootLinks, topTagLinks, topicLinkGroups } from '../lib/deals/facets';

interface Props {
  city: CityEntry;
  page: number;
}
const { city, page } = Astro.props;
const guides = await guidesFor({ city: city.slug });
const { deals } = await getDeals();
const byId = new Map(deals.map((deal) => [deal.id, deal]));
const cityDeals = sortEntries(deals.filter((deal) => deal.citySlug === city.slug).map(toIndexEntry)).map((entry) => byId.get(entry.id)!);
const perCategory = countBy(cityDeals, (deal) => deal.category);
const { citySegments } = facetsOf(deals);
const districtLinks = citySegments
  .filter((p) => p.citySlug === city.slug && p.kind === 'district')
  .sort((a, b) => b.deals.length - a.deals.length);
// category tree of the city (Masaj › Spa › Hamam…), then the remaining provider tags
const subPages = new Set(citySegments.filter((p) => p.citySlug === city.slug && p.kind === 'tag').map((p) => p.slug));
const cityHref = (slug: string) => `/sehir/${city.slug}/${slug}/`;
const tree = topicLinkGroups(cityDeals, subPages, cityHref, { maxDepth: 1 });
const quick = rootLinks(tree);
const menus = [
  {
    label: 'İlçeler',
    icon: 'pin' as const,
    groups: [
      {
        title: `${city.name} ilçeleri`,
        items: [...districtLinks]
          .sort((a, b) => a.name.localeCompare(b.name, 'tr'))
          .map((p) => ({ href: `/sehir/${city.slug}/${p.slug}/`, label: p.name, count: p.deals.length })),
      },
    ],
  },
  {
    label: 'Kategoriler',
    icon: 'tag' as const,
    groups: [
      {
        title: 'Ana kategoriler',
        items: CATEGORIES.filter((category) => perCategory.has(category.slug)).map((category) => {
          const count = perCategory.get(category.slug)!;
          return {
            href:
              count >= MIN_COMBO_PAGE
                ? `/kategori/${category.slug}/${city.slug}/`
                : `/firsatlar/?kategori=${category.slug}&sehir=${city.slug}`,
            label: category.shortName,
            count,
          };
        }),
      },
      ...tree,
      {
        title: 'Diğer alt kategoriler',
        items: topTagLinks(cityDeals, subPages, 24).map((tag) => ({ href: cityHref(tag.slug), label: tag.name, count: tag.count })),
      },
    ],
  },
];
const crumbs = [
  { name: 'Ana sayfa', path: '/' },
  { name: 'Şehirler', path: '/sehirler/' },
  { name: city.name, path: `/sehir/${city.slug}/` },
];
const intro =
  city.intro ??
  `${city.name} için iş ortaklarımızdan gelen güncel fırsatları burada listeliyoruz. Fırsatların geçerli olduğu ilçe ve şubeyi satın almadan önce kontrol etmeyi unutmayın.`;
---

<FacetView
  title={`${city.name} Fırsatları ve Kampanyaları`}
  heading={`${city.name} fırsatları`}
  eyebrow={city.count > 0 ? `${city.name} · ${city.count} güncel fırsat` : `${city.name} · Güncel fırsat bekleniyor`}
  description={`${city.name} için yeme içme, güzellik, etkinlik ve konaklama fırsatları. ${city.count > 0 ? `${city.count} güncel fırsatı` : 'Güncel fırsatları'} kategori ve ilçe bilgisiyle inceleyin.`}
  lead={intro}
  deals={cityDeals}
  crumbs={crumbs}
  canonical={`/sehir/${city.slug}/`}
  noindex={city.count < MIN_CITY_INDEX}
  quick={quick}
  menus={menus}
  placement={`city-${city.slug}`}
  page={page}
  guides={guides}
  nationwide
  emptyText={`${city.name} için şu anda yetkili kaynaklarımızdan gelen yayında bir fırsat bulunmuyor.`}
/>
