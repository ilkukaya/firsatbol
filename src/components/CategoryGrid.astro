---
import Icon from './Icon.astro';
import { CATEGORIES } from '../config/categories';

interface Props {
  counts: Map<string, number>;
}
const { counts } = Astro.props;
---

<ul class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
  {CATEGORIES.map((category) => {
    const count = counts.get(category.slug) ?? 0;
    return (
      <li>
        <a
          href={`/kategori/${category.slug}/`}
          class="card group flex h-full flex-col gap-3 p-4 transition-all hover:-translate-y-0.5 hover:shadow-[var(--shadow-lift)] sm:p-5"
        >
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-text transition-colors group-hover:bg-brand group-hover:text-white">
            <Icon name={category.icon} size={22} />
          </span>
          <span class="font-bold leading-snug text-ink">{category.name}</span>
          <span class="mt-auto text-xs font-semibold text-muted">{count > 0 ? `${count} fırsat` : 'Yakında'}</span>
        </a>
      </li>
    );
  })}
</ul>
