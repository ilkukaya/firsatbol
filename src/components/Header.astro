---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { CATEGORIES } from '../config/categories';
import { getDeals } from '../lib/deals/repository';
import { categoryCounts, citiesWithDeals } from '../lib/deals/taxonomy';

const { deals } = await getDeals();
const allCities = citiesWithDeals(deals);
// keep the header light: the busiest cities (featured ones first while data is thin) + a link to all cities
const cities = [...allCities].sort((a, b) => b.count - a.count || Number(b.featured) - Number(a.featured)).slice(0, 16);
const moreCities = allCities.length > cities.length;
const path = Astro.url.pathname;
const query = Astro.url.searchParams.get('q') ?? '';
const isActive = (href: string) => path.startsWith(href);

// category navigation: each category in its own accent colour; empty categories ("Yakında") are left out
const counts = categoryCounts(deals);
const navItems = [
  { href: '/firsatlar/', label: 'Tümü', icon: 'tag' as const, accent: '#0f1b2d', accentBg: '#efe9e1', count: 0 },
  ...CATEGORIES.filter((category) => (counts.get(category.slug) ?? 0) > 0).map((category) => ({
    href: `/kategori/${category.slug}/`,
    label: category.shortName,
    icon: category.icon,
    accent: category.accent,
    accentBg: category.accentBg,
    count: counts.get(category.slug) ?? 0,
  })),
  { href: '/rehber/', label: 'Rehberler', icon: 'book' as const, accent: '#475569', accentBg: '#f1f5f9', count: 0 },
];
---

<header class="z-40 md:sticky md:top-0 border-b border-line/80 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/85">
  <div class="container-page">
    <div class="flex h-16 items-center gap-3 sm:gap-5">
      <a href="/" class="shrink-0 rounded-lg" aria-label="FırsatBol ana sayfa">
        <Logo />
      </a>

      <form action="/arama/" method="get" role="search" class="relative hidden flex-1 md:block" data-search-form>
        <label for="header-search" class="sr-only">
          Fırsatlarda ara
        </label>
        <Icon name="search" size={18} class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-muted" />
        <input
          id="header-search"
          name="q"
          type="search"
          value={query}
          placeholder="Kahvaltı, masaj, otel, kulaklık…"
          autocomplete="off"
          enterkeyhint="search"
          class="h-11 w-full rounded-full border border-line bg-canvas pl-11 pr-4 text-[0.95rem] placeholder:text-muted/80 focus:border-ink/30 focus:bg-white focus:outline-none focus:ring-4 focus:ring-brand/15"
        />
      </form>

      <div class="ml-auto flex items-center gap-2 md:ml-0">
        <details class="relative hidden sm:block" data-dropdown>
          <summary class="chip cursor-pointer list-none select-none [&::-webkit-details-marker]:hidden">
            <Icon name="pin" size={17} class="text-brand-text" />
            <span>Şehir seç</span>
            <Icon name="chevron-down" size={16} />
          </summary>
          <div class="card absolute right-0 top-[calc(100%+0.5rem)] z-50 w-64 p-2">
            <p class="px-3 pb-1 pt-2 text-xs font-bold uppercase tracking-wider text-muted">Şehirler</p>
            <ul class="max-h-80 overflow-y-auto">
              {cities.map((city) => (
                <li>
                  <a
                    href={`/sehir/${city.slug}/`}
                    class="flex items-center justify-between rounded-lg px-3 py-2 text-[0.95rem] hover:bg-canvas"
                  >
                    <span>{city.name}</span>
                    {city.count > 0 && <span class="text-xs font-semibold text-muted">{city.count}</span>}
                  </a>
                </li>
              ))}
            </ul>
            {moreCities && (
              <a href="/sehirler/" class="mt-1 block rounded-lg px-3 py-2 text-sm font-bold text-brand-text hover:bg-canvas">
                Tüm şehirler →
              </a>
            )}
          </div>
        </details>
        <a href="/firsatlar/" class="btn-cta hidden px-4 py-2 text-sm lg:inline-flex">
          Tüm Fırsatlar
        </a>
        <button
          type="button"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-line bg-white md:hidden"
          aria-controls="mobile-menu"
          aria-expanded="false"
          data-menu-toggle
        >
          <span class="sr-only">Menüyü aç</span>
          <Icon name="menu" size={22} />
        </button>
      </div>
    </div>

    <form action="/arama/" method="get" role="search" class="relative pb-3 md:hidden" data-search-form>
      <label for="header-search-mobile" class="sr-only">
        Fırsatlarda ara
      </label>
      <Icon name="search" size={18} class="pointer-events-none absolute left-4 top-[1.375rem] -translate-y-1/2 text-muted" />
      <input
        id="header-search-mobile"
        name="q"
        type="search"
        value={query}
        placeholder="Fırsat ara…"
        autocomplete="off"
        enterkeyhint="search"
        class="h-11 w-full rounded-full border border-line bg-canvas pl-11 pr-4 text-base focus:border-ink/30 focus:bg-white focus:outline-none focus:ring-4 focus:ring-brand/15"
      />
    </form>

    <nav aria-label="Kategoriler" class="-mx-4 overflow-x-auto px-4 pb-3 scrollbar-none sm:-mx-6 sm:px-6 lg:mx-0 lg:px-0">
      <ul class="flex w-max gap-2">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <li>
              <a
                href={item.href}
                style={`--accent:${item.accent};--accent-bg:${item.accentBg}`}
                class:list={[
                  'group flex items-center gap-2 whitespace-nowrap rounded-full py-1 pl-1 pr-3.5 text-sm font-semibold ring-1 transition duration-200',
                  active
                    ? 'bg-[var(--accent)] text-white ring-transparent shadow-sm'
                    : 'bg-white text-ink-2 ring-line hover:bg-[var(--accent-bg)] hover:text-[var(--accent)] hover:ring-[color-mix(in_srgb,var(--accent)_35%,transparent)]',
                ]}
                aria-current={active ? 'page' : undefined}
              >
                <span
                  class:list={[
                    'flex h-7 w-7 items-center justify-center rounded-full transition duration-200',
                    active
                      ? 'bg-white/20 text-white'
                      : 'bg-[var(--accent-bg)] text-[var(--accent)] group-hover:bg-[var(--accent)] group-hover:text-white motion-safe:group-hover:-rotate-6',
                  ]}
                  aria-hidden="true"
                >
                  <Icon name={item.icon} size={15} />
                </span>
                {item.label}
                {item.count > 0 && (
                  <span class:list={['text-xs font-medium', active ? 'text-white/80' : 'text-muted group-hover:text-[var(--accent)]']}>
                    {item.count.toLocaleString('tr-TR')}
                  </span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-white md:hidden" data-menu-panel>
    <div class="container-page grid gap-6 py-5">
      <div>
        <p class="mb-2 text-xs font-bold uppercase tracking-wider text-muted">Şehirler</p>
        <ul class="flex flex-wrap gap-2">
          {cities.map((city) => (
            <li>
              <a href={`/sehir/${city.slug}/`} class="chip">
                {city.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <ul class="grid gap-1 text-[1.05rem] font-semibold">
        <li>
          <a class="block rounded-lg py-2" href="/firsatlar/">
            Tüm fırsatlar
          </a>
        </li>
        <li>
          <a class="block rounded-lg py-2" href="/sehirler/">
            Tüm şehirler
          </a>
        </li>
        <li>
          <a class="block rounded-lg py-2" href="/rehber/">
            Alışveriş rehberleri
          </a>
        </li>
        <li>
          <a class="block rounded-lg py-2" href="/firsatlarin-kaynagi/">
            Fırsatların kaynağı
          </a>
        </li>
        <li>
          <a class="block rounded-lg py-2" href="/hakkimizda/">
            Hakkımızda
          </a>
        </li>
        <li>
          <a class="block rounded-lg py-2" href="/iletisim/">
            İletişim
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>
