---
/**
 * FırsatBol mark: an orange tile holding a tilted price tag with a spark —
 * "a smart find among plenty of deals". Original artwork; see public/favicon.svg.
 */
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 36, class: className, title } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width="48" height="48" rx="13" fill="#ff6a1a"></rect>
  <path d="M0 30c9 6 22 9 48-2v7c0 7-6 13-13 13H13C6 48 0 42 0 35z" fill="#f2560b" opacity="0.55"></path>
  <g transform="rotate(-22 24 25)">
    <path
      d="M24 8.5l10.2 8.3c.5.4.8 1 .8 1.7V36a3.5 3.5 0 0 1-3.5 3.5h-15A3.5 3.5 0 0 1 13 36V18.5c0-.7.3-1.3.8-1.7z"
      fill="#ffffff"
    ></path>
    <circle cx="24" cy="18.6" r="2.9" fill="#0f1b2d"></circle>
    <path d="M18.5 30.5l11-6.2M19.4 25.3h.01M28.6 31.4h.01" stroke="#ff6a1a" stroke-width="3" stroke-linecap="round"></path>
  </g>
  <path d="M38.6 6.2l1.2 3.1 3.1 1.2-3.1 1.2-1.2 3.1-1.2-3.1-3.1-1.2 3.1-1.2z" fill="#ffcf3f"></path>
</svg>
