---
/**
 * Share a deal: WhatsApp first (the way deals travel in Türkiye), then Telegram, X, Facebook,
 * copy link and the phone's own share sheet. Intents open the network's page/app; nothing is
 * loaded from them here. The link preview (photo, "%43 indirim · 429 TL — …") comes from the
 * deal page's Open Graph tags.
 */
import { SITE } from '../config/site';
import type { Deal } from '../lib/deals/schema';
import { shareHeadline, shareIntents } from '../lib/share';
import { ogCard, ogImagePath } from '../lib/og';

interface Props {
  deal: Deal;
  /** `full`: sidebar block; `compact`: one row under the title (phones). */
  variant?: 'full' | 'compact';
  class?: string;
}
const { deal, variant = 'full', class: className } = Astro.props;
const intents = shareIntents(SITE.url, deal);
const headline = shareHeadline(deal);
const icons = {
  whatsapp:
    'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z',
  telegram:
    'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z',
  x: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z',
  facebook:
    'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z',
};
const others = [
  { channel: 'telegram', label: 'Telegram’da paylaş', href: intents.telegram, color: 'bg-[#229ED9] text-white', icon: icons.telegram },
  { channel: 'x', label: 'X’te paylaş', href: intents.x, color: 'bg-ink text-white', icon: icons.x },
  { channel: 'facebook', label: 'Facebook’ta paylaş', href: intents.facebook, color: 'bg-[#1877F2] text-white', icon: icons.facebook },
] as const;
const compact = variant === 'compact';
---

<div
  class:list={[compact ? 'flex items-center gap-2' : 'mt-5 border-t border-line pt-4', className]}
  data-share
  data-deal-id={deal.id}
  data-share-url={intents.native}
  data-share-copy={intents.copy}
  data-share-title={headline}
  data-share-text={intents.message}
  data-share-card={ogImagePath(deal.slug, ogCard(deal))}
>
  {!compact && <p class="mb-3 text-sm font-bold text-ink">Arkadaşlarınla paylaş</p>}
  <a
    href={intents.whatsapp}
    target="_blank"
    rel="noopener"
    data-share-channel="whatsapp"
    class:list={[
      'inline-flex items-center justify-center gap-2 rounded-full bg-[#25D366] font-bold text-[#052e16] shadow-sm transition hover:bg-[#1fbe5a] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#128C7E]',
      compact ? 'flex-1 px-4 py-2.5 text-sm' : 'w-full px-5 py-3 text-base',
    ]}
  >
    <svg viewBox="0 0 24 24" width={compact ? 18 : 20} height={compact ? 18 : 20} fill="currentColor" aria-hidden="true">
      <path d={icons.whatsapp} />
    </svg>
    WhatsApp’ta paylaş
  </a>
  <div class:list={['flex items-center gap-2', !compact && 'mt-3']}>
    {!compact &&
      others.map((item) => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener"
          aria-label={item.label}
          title={item.label}
          data-share-channel={item.channel}
          class:list={['flex h-10 w-10 items-center justify-center rounded-full transition hover:opacity-90', item.color]}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d={item.icon} />
          </svg>
        </a>
      ))}
    <button
      type="button"
      data-share-channel="copy"
      class="flex h-10 items-center gap-1.5 rounded-full bg-white px-3.5 text-sm font-semibold text-ink-2 ring-1 ring-line transition hover:text-ink hover:ring-ink/30"
    >
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path>
        <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path>
      </svg>
      <span data-share-copy-label>{compact ? 'Kopyala' : 'Linki kopyala'}</span>
    </button>
    <button
      type="button"
      data-share-channel="native"
      hidden
      class="flex h-10 items-center gap-1.5 rounded-full bg-white px-3.5 text-sm font-semibold text-ink-2 ring-1 ring-line transition hover:text-ink hover:ring-ink/30"
    >
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7M16 6l-4-4-4 4M12 2v14"></path>
      </svg>
      Diğer
    </button>
  </div>
</div>

<script>
  import { track } from '../scripts/analytics';

  document.querySelectorAll<HTMLElement>('[data-share]').forEach((root) => {
    const {
      dealId,
      shareUrl = location.href,
      shareCopy = location.href,
      shareTitle = document.title,
      shareText = '',
      shareCard,
    } = root.dataset;
    // draw the price card as soon as someone reaches for a share button, so it is cached by the time
    // WhatsApp's crawler asks for it (the first render can take a few seconds)
    let warmed = false;
    const warm = () => {
      if (warmed || !shareCard) return;
      warmed = true;
      new Image().src = shareCard;
    };
    ['pointerenter', 'touchstart', 'focusin'].forEach((type) => root.addEventListener(type, warm, { passive: true, once: true }));
    const native = root.querySelector<HTMLButtonElement>('[data-share-channel="native"]');
    if (native && typeof navigator.share === 'function') native.hidden = false;
    root.addEventListener('click', async (event) => {
      const control = (event.target as Element).closest<HTMLElement>('[data-share-channel]');
      if (!control) return;
      const channel = control.dataset.shareChannel!;
      warm();
      track('deal_share', { deal: dealId, placement: channel });
      if (channel === 'copy') {
        event.preventDefault();
        const label = control.querySelector<HTMLElement>('[data-share-copy-label]');
        try {
          await navigator.clipboard.writeText(shareCopy);
          if (label) {
            const before = label.textContent;
            label.textContent = 'Kopyalandı ✓';
            window.setTimeout(() => (label.textContent = before), 2000);
          }
        } catch {
          window.prompt('Linki kopyalayın:', shareCopy);
        }
      } else if (channel === 'native') {
        event.preventDefault();
        try {
          await navigator.share({ title: shareTitle, text: shareText, url: shareUrl });
        } catch {
          /* cancelled */
        }
      }
    });
  });
</script>
